# Copy this file to .env.local to override defaults. .env.local is git-ignored.
# The app needs no API keys or secrets (ADR-0008).
#
# Optional: MapLibre style URL for the base map.
# Default: https://tiles.openfreemap.org/styles/liberty (free OpenStreetMap tiles, no key)
VITE_MAP_STYLE_URL=
#
# Optional: where the segment catalog is stored (BR-23, ADR-0011).
# Default: data/segment-catalog.json in the project folder. Read by the dev/preview server only,
# never sent to the browser. Delete the file (with the app stopped) to remove all segment data.
SEGMENT_CATALOG_PATH=
#
# Optional: an earlier SQLite segment database (ADR-0009) to migrate once into the catalog (BR-30).
# Default: data/segments.sqlite. Used only while the catalog file does not exist yet; afterwards the
# database is renamed to <file>.migrated, which you can delete.
SEGMENTS_DB_PATH=
#
# Optional: where the ride history and upload registry are stored (BR-33, ADR-0013).
# Default: data/rides.sqlite in the project folder. Read by the dev/preview server only. Delete the
# file (with the app stopped) to remove all stored rides and uploads.
RIDES_DB_PATH=
#
# Optional: where the local AI assistant keeps its settings and model test results (BRD v2.4,
# ADR-0014). Default: data/assistant-settings.json in the project folder. No secrets: the assistant
# needs no API key and talks only to Ollama on this computer. (Ollama's own OLLAMA_NO_CLOUD=1, set
# where Ollama runs, makes Ollama refuse cloud models as well; the app refuses them either way.)
ASSISTANT_SETTINGS_PATH=
#
# Optional, only for `npm run fetch-segments` (BR-31, ADR-0012): your Strava access token, copied
# from https://www.strava.com/settings/api (read access, valid for 6 hours). Put it in .env.local,
# never in this file and never in git. The app itself never uses it.
STRAVA_ACCESS_TOKEN=
