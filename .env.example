# Copy this file to .env.local to override defaults. .env.local is git-ignored.
# The app needs no API keys or secrets (ADR-0008).
#
# Optional: MapLibre style URL for the base map.
# Default: https://tiles.openfreemap.org/styles/liberty (free OpenStreetMap tiles, no key)
VITE_MAP_STYLE_URL=
#
# Optional: where the local segment database is stored (BR-23, ADR-0009).
# Default: data/segments.sqlite in the project folder. Read by the dev/preview server only, never
# sent to the browser. Delete the file (with the app stopped) to remove all segment data.
SEGMENTS_DB_PATH=
